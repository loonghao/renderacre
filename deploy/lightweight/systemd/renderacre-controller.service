[Unit]
Description=Renderacre Controller
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=renderacre
Group=renderacre
WorkingDirectory=/opt/renderacre
Environment=RUST_LOG=farm_controller=info,tower_http=info
ExecStart=/usr/local/bin/renderacre-controller --config /etc/renderacre/controller.yaml
Restart=on-failure
RestartSec=5
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
