[Unit]
Description=Renderacre Worker
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=renderacre
Group=renderacre
WorkingDirectory=/var/lib/renderacre-worker
Environment=RUST_LOG=farm_worker=info
ExecStart=/usr/local/bin/renderacre-worker --config /etc/renderacre/worker.yaml
Restart=on-failure
RestartSec=5
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
